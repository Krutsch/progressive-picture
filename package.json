{
  "name": "progressive-picture",
  "version": "3.2.0",
  "description": "Native Lazy Loaded Picture Element with Progressive Image Change",
  "type": "module",
  "main": "./dist/progressive-picture.js",
  "module": "./dist/progressive-picture.js",
  "types": "./dist/progressive-picture.d.ts",
  "exports": {
    ".": {
      "types": "./dist/progressive-picture.d.ts",
      "import": "./dist/progressive-picture.js",
      "default": "./dist/progressive-picture.js"
    }
  },
  "files": [
    "dist/progressive-picture.d.ts",
    "dist/progressive-picture.js"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "tsc",
    "build": "tsc",
    "test": "npm run test:jsdom && npm run test:browser",
    "test:jsdom": "tsc -p tsconfig.test.json && vitest run test/progressive-picture.test.ts --environment jsdom",
    "test:browser": "playwright test",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "image",
    "picture",
    "dom",
    "lazyload",
    "element",
    "intersectionobserver",
    "mutationobserver",
    "picture",
    "progressive",
    "progressive image"
  ],
  "author": {
    "name": "Fabian Klingenberg",
    "email": "klingenberg.fabianh@gmx.de",
    "url": "https://klingenberg.works/"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krutsch/progressive-picture.git"
  },
  "bugs": "https://github.com/Krutsch/progressive-picture/issues"
}
